{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:capability-passport-present.refusal:v2",
  "title": "CapabilityPassportPresentRefusal v2",
  "description": "Typed refusal of an exact-passport peer renewal.",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/076-limited-messaging-grants-decision.md",
    "doc/project/40-proposals/024-capability-passports-and-network-ledger-delegation.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "capability-passport-present.refusal.v2"
    },
    "status": {
      "const": "refused"
    },
    "reason": {
      "enum": [
        "unsupported-carrier",
        "invalid-request",
        "passport-unavailable",
        "disclosure-disabled",
        "root-unavailable",
        "status-unavailable",
        "status-too-old",
        "limit-exceeded"
      ]
    }
  }
}
