{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:package-capability-status.request:v1",
  "title": "Package Capability Status Request v1",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/093-package-scoped-private-capabilities.md"
  ],
  "description": "A read-only status query of one invocation (P093 §13). It carries no input, is authorized like an invocation, reads only the host journal and never dispatches or reconciles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema/v",
    "capability/id",
    "contract/digest",
    "invocation/id",
    "request/digest"
  ],
  "properties": {
    "schema": {
      "const": "package-capability-status.request.v1"
    },
    "schema/v": {
      "const": 1
    },
    "capability/id": {
      "$ref": "#/$defs/capability-id"
    },
    "contract/digest": {
      "$ref": "#/$defs/digest"
    },
    "invocation/id": {
      "$ref": "#/$defs/invocation-id"
    },
    "request/digest": {
      "$ref": "#/$defs/digest"
    },
    "use-binding/ref": {
      "$ref": "#/$defs/ref"
    }
  },
  "$defs": {
    "capability-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9._-]*@(pkg|node-pkg|peer-pkg):did:key:z[1-9A-HJ-NP-Za-km-z]+/[a-z0-9][a-z0-9._-]*$",
      "description": "A package capability identifier (P093 §2); the host parses it with the one grammar."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "invocation-id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^package-invocation:[A-Za-z0-9._-]+$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s]+$"
    }
  }
}
