{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-issuer-bootstrap-descriptor.local:v1",
  "title": "nym-issuer-bootstrap-descriptor.local.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "issued/at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    },
    "expires/at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    }
  },
  "required": [
    "operation/id",
    "issued/at",
    "expires/at"
  ]
}
