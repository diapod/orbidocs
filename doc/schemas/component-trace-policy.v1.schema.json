{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:component-trace-policy:v1",
  "title": "Component Trace Policy V1",
  "description": "Bounded effective capture policy for one node process.",
  "x-dia-workflow": "project",
  "x-dia-status": "accepted",
  "x-dia-basis": ["doc/project/40-proposals/086-component-communication-observation-and-trace-sessions.md"],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema/v", "policy/ref", "policy/digest", "policy/generation", "profile", "selectors", "capture/interest", "capture/content", "digest/permitted", "record/max-bytes", "session/max-bytes", "session/ttl-seconds", "hard-secret/classes", "reason"],
  "properties": {
    "schema": {"const": "component-trace-policy.v1"},
    "schema/v": {"const": 1},
    "policy/ref": {"$ref": "#/$defs/ref"},
    "policy/digest": {"$ref": "#/$defs/digest"},
    "policy/generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "profile": {"description": "Runtime posture selecting the disabled baseline or an explicit bounded capture context.", "enum": ["production", "development", "test", "acceptance", "operator-debug"]},
    "selectors": {"$ref": "#/$defs/selectors"},
    "capture/interest": {"description": "Maximum observation detail requested before boundary and secret-policy intersection.", "enum": ["none", "metadata", "digest", "redacted", "content"]},
    "capture/content": {"enum": ["none", "inline", "artifact"]},
    "digest/permitted": {"type": "boolean"},
    "record/max-bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "session/max-bytes": {"type": "integer", "minimum": 1, "maximum": 17179869184},
    "session/ttl-seconds": {"type": "integer", "minimum": 1, "maximum": 28800},
    "hard-secret/classes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "operator/binding-ref": {"$ref": "#/$defs/ref"},
    "expires/at": {"type": "string", "format": "date-time", "maxLength": 64},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[ -~]+$"}
  },
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[ -~]+$"},
    "digest": {"type": "string", "pattern": "^sha256:([0-9A-Fa-f]{64}|[A-Za-z0-9_-]{43})$"},
    "selectors": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary/ids", "component/refs", "operations", "schema/refs", "evidence/kinds"],
      "properties": {
        "boundary/ids": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "component/refs": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "operations": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "schema/refs": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "evidence/kinds": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["host-observed", "component-reported"]}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "production"}}, "required": ["profile"]},
      "then": {
        "properties": {"capture/interest": {"const": "none"}, "capture/content": {"const": "none"}, "digest/permitted": {"const": false}},
        "not": {"anyOf": [{"required": ["operator/binding-ref"]}, {"required": ["expires/at"]}]}
      }
    },
    {
      "if": {"properties": {"profile": {"const": "operator-debug"}}, "required": ["profile"]},
      "then": {"required": ["operator/binding-ref", "expires/at"]}
    }
  ]
}
