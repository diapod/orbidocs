{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:agent.external-runtime.event:v1",
  "title": "Agent External Runtime Event v1",
  "oneOf": [
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/action-candidate" },
    { "$ref": "#/$defs/product-candidate" },
    { "$ref": "#/$defs/tool-request" },
    { "$ref": "#/$defs/operator-question" },
    { "$ref": "#/$defs/usage" },
    { "$ref": "#/$defs/turn-outcome" }
  ],
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$" },
    "at": { "type": "string", "format": "date-time" },
    "base-properties": {
      "type": "object",
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" },
        "event/ref": { "$ref": "#/$defs/ref" },
        "turn/ref": { "$ref": "#/$defs/ref" },
        "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "at": { "$ref": "#/$defs/at" }
      }
    },
    "progress": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event/ref", "turn/ref", "seq/no", "kind", "progress/code", "progress/current", "at"],
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" }, "event/ref": { "$ref": "#/$defs/ref" }, "turn/ref": { "$ref": "#/$defs/ref" }, "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 }, "kind": { "const": "progress" },
        "progress/code": { "enum": ["accepted", "running", "awaiting-observation", "cancelling", "reconciling"] },
        "progress/current": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "progress/total": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "at": { "$ref": "#/$defs/at" }
      }
    },
    "action-candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event/ref", "turn/ref", "seq/no", "kind", "action/schema", "action/digest", "at"],
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" }, "event/ref": { "$ref": "#/$defs/ref" }, "turn/ref": { "$ref": "#/$defs/ref" }, "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 }, "kind": { "const": "action-candidate" },
        "action/schema": { "$ref": "#/$defs/ref" }, "action/digest": { "$ref": "#/$defs/digest" }, "at": { "$ref": "#/$defs/at" }
      }
    },
    "product-candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event/ref", "turn/ref", "seq/no", "kind", "content", "output-schema/ref", "at"],
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" }, "event/ref": { "$ref": "#/$defs/ref" }, "turn/ref": { "$ref": "#/$defs/ref" }, "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 }, "kind": { "const": "product-candidate" },
        "content": { "type": "string", "minLength": 1, "maxLength": 1048576 }, "output-schema/ref": { "$ref": "#/$defs/ref" }, "at": { "$ref": "#/$defs/at" }
      }
    },
    "tool-request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event/ref", "turn/ref", "seq/no", "kind", "request/ref", "tool/ref", "input/schema-ref", "input/digest", "input", "classification", "deadline/at", "at"],
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" }, "event/ref": { "$ref": "#/$defs/ref" }, "turn/ref": { "$ref": "#/$defs/ref" }, "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 }, "kind": { "const": "tool-request" },
        "request/ref": { "$ref": "#/$defs/ref" }, "tool/ref": { "$ref": "#/$defs/ref" }, "input/schema-ref": { "$ref": "#/$defs/ref" }, "input/digest": { "$ref": "#/$defs/digest" }, "input": { "type": "object", "minProperties": 1, "maxProperties": 64 }, "classification": { "$ref": "classification.v1.schema.json" }, "deadline/at": { "$ref": "#/$defs/at" }, "at": { "$ref": "#/$defs/at" }
      }
    },
    "operator-question": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event/ref", "turn/ref", "seq/no", "kind", "request/ref", "question/schema-ref", "question/digest", "question", "deadline/at", "at"],
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" }, "event/ref": { "$ref": "#/$defs/ref" }, "turn/ref": { "$ref": "#/$defs/ref" }, "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 }, "kind": { "const": "operator-question" },
        "request/ref": { "$ref": "#/$defs/ref" }, "question/schema-ref": { "$ref": "#/$defs/ref" }, "question/digest": { "$ref": "#/$defs/digest" }, "question": { "type": "object", "minProperties": 1, "maxProperties": 64 }, "deadline/at": { "$ref": "#/$defs/at" }, "at": { "$ref": "#/$defs/at" }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event/ref", "turn/ref", "seq/no", "kind", "usage/fidelity", "usage", "at"],
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" }, "event/ref": { "$ref": "#/$defs/ref" }, "turn/ref": { "$ref": "#/$defs/ref" }, "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 }, "kind": { "const": "usage" },
        "usage/fidelity": { "enum": ["authoritative", "host-measured", "estimated", "unavailable"] },
        "usage": { "$ref": "#/$defs/usage-value" }, "at": { "$ref": "#/$defs/at" }
      }
    },
    "turn-outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "event/ref", "turn/ref", "seq/no", "kind", "status", "reason/code", "at"],
      "properties": {
        "schema": { "const": "agent.external-runtime.event.v1" }, "event/ref": { "$ref": "#/$defs/ref" }, "turn/ref": { "$ref": "#/$defs/ref" }, "seq/no": { "type": "integer", "minimum": 1, "maximum": 1024 }, "kind": { "const": "turn-outcome" },
        "status": { "enum": ["completed", "refused", "failed", "cancelled", "unknown"] },
        "reason/code": { "$ref": "#/$defs/reason-code" }, "at": { "$ref": "#/$defs/at" }
      }
    },
    "usage-value": {
      "type": "object", "additionalProperties": false,
      "required": ["max_tokens", "max_cost_micros", "max_wall_time_ms", "max_steps"],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "max_cost_micros": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "max_wall_time_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "max_steps": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "reason-code": { "enum": [
      "completed", "policy-denied", "binding-missing", "binding-stale", "binding-mismatch",
      "binding-expired", "binding-revoked", "profile-disabled", "profile-mismatch",
      "budget-exhausted", "usage-missing", "usage-malformed", "usage-overflow", "usage-conflict",
      "session-fence-mismatch", "session-lost", "event-malformed", "event-duplicate",
      "event-reordered", "event-oversized", "event-unauthorized", "event-stale", "event-timeout",
      "tool-not-admitted", "approval-not-admitted", "provider-unavailable", "cancelled", "unknown"
    ] }
  }
}
