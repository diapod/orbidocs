{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:corpus-reasoning-chair-experiment-decision:v1",
  "title": "Corpus Reasoning Chair Experiment Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema/v",
    "decision/ref",
    "query/id",
    "room/id",
    "proposal/ref",
    "review/ref",
    "review/digest",
    "reviewed-candidate-plan/ref",
    "reviewed-candidate-plan/artifact-ref",
    "reviewed-candidate-plan/digest",
    "chair",
    "chair/node-id",
    "decision",
    "reason/code",
    "class/key",
    "decided-at",
    "expires-at",
    "idempotency/key",
    "signature"
  ],
  "properties": {
    "schema/v": { "const": 1 },
    "decision/ref": {
      "type": "string",
      "pattern": "^corpus-experiment-chair-decision:sha256:[A-Za-z0-9_-]{43}$"
    },
    "query/id": { "type": "string", "pattern": "^query:[^\\s]+$", "maxLength": 512 },
    "room/id": { "type": "string", "pattern": "^room:[^\\s]+$", "maxLength": 512 },
    "proposal/ref": {
      "type": "string",
      "pattern": "^corpus-experiment:sha256:[A-Za-z0-9_-]{43}$"
    },
    "review/ref": {
      "type": "string",
      "pattern": "^corpus-experiment-review:sha256:[A-Za-z0-9_-]{43}$"
    },
    "review/digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "reviewed-candidate-plan/ref": {
      "type": "string",
      "pattern": "^candidate-plan/[^\\s]+$",
      "maxLength": 512
    },
    "reviewed-candidate-plan/artifact-ref": {
      "type": "string",
      "pattern": "^object-store:sha256:[A-Za-z0-9_-]{43}$"
    },
    "reviewed-candidate-plan/digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "chair": { "$ref": "corpus-reasoning-room-policy.v1.schema.json#/$defs/room-subject" },
    "chair/node-id": {
      "type": "string",
      "pattern": "^node:did:key:[^\\s]+$",
      "maxLength": 512
    },
    "chair-agent/ref": {
      "type": "string",
      "pattern": "^agent:[^\\s]+$",
      "maxLength": 512
    },
    "decision": {
      "enum": ["block", "request-revision", "admit-reviewed-candidate"]
    },
    "reason/code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "class/key": { "enum": ["Public", "Community", "Personal"] },
    "decided-at": { "type": "string", "format": "date-time" },
    "expires-at": { "type": "string", "format": "date-time" },
    "idempotency/key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value", "key/public"],
      "properties": {
        "alg": { "const": "ed25519+domain-v1" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
        "key/public": { "type": "string", "pattern": "^z[A-Za-z0-9]+$", "maxLength": 128 }
      }
    }
  },
  "x-dia-status": "accepted",
  "x-dia-basis": [
    "doc/project/30-stories/story-012-agents-share-chair-terminal.md",
    "doc/project/40-proposals/069-corpus.md",
    "doc/project/60-solutions/038-corpus/038-corpus.md",
    "doc/project/60-solutions/047-agent/047-agent.md"
  ]
}
