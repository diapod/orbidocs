{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:sensorium-biosignal-capture:v1",
  "title": "sensorium-biosignal-capture.v1",
  "description": "Reserved optional retained capture contract. Requires independent capture admission, quota, retention and Artifact Delivery policy; transient sample reads never imply recording. First slice exposes no capture route. Partial/final state must reflect actual completeness; no values embedded.",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/096-sensorium-brainflow-connector.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema/v",
    "capture/ref",
    "instance/ref",
    "profile/ref",
    "session/epoch",
    "source/generation",
    "capture/state",
    "classification",
    "artifacts",
    "capture-authority/ref",
    "retention/expires-at-unix-s"
  ],
  "properties": {
    "schema": {
      "const": "sensorium-biosignal-capture.v1"
    },
    "schema/v": {
      "const": 1
    },
    "capture/ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "instance/ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "profile/ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "session/epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source/generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "capture/state": {
      "enum": [
        "partial",
        "final",
        "tombstoned"
      ]
    },
    "classification": {
      "$ref": "classification.v1.schema.json"
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact/ref",
          "stream/id",
          "sequence/first",
          "sequence/last",
          "bytes"
        ],
        "properties": {
          "artifact/ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "stream/id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "sequence/first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sequence/last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          }
        }
      }
    },
    "capture-authority/ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "retention/expires-at-unix-s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
