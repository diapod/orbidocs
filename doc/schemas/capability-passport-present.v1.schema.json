{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:capability-passport-present:v1",
  "title": "CapabilityPassportPresent v1",
  "description": "Wire presentation retaining the complete signed passport proof. For V2 Messaging receive consent only, an optional bounded signed issuance status permits verification against an independently admitted local root without status acquisition. Unsupported consumers must not claim offline acceptance.",
  "type": "object",
  "additionalProperties": true,
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/014-node-transport-and-discovery-mvp.md",
    "doc/project/40-proposals/024-capability-passports-and-network-ledger-delegation.md",
    "doc/project/40-proposals/076-limited-messaging-grants-decision.md",
    "doc/project/50-requirements/requirements-006-node-networking-mvp.md",
    "doc/project/60-solutions/007-capability-advertisement/007-capability-advertisement.md",
    "doc/project/60-solutions/000-node/000-node.md"
  ],
  "required": [
    "schema",
    "passport"
  ],
  "properties": {
    "schema": {
      "const": "capability-passport-present.v1",
      "description": "Schema discriminator. Must equal `capability-passport-present.v1`."
    },
    "passport": {
      "oneOf": [
        {
          "$ref": "capability-passport.v1.schema.json"
        },
        {
          "$ref": "capability-passport.v2.schema.json"
        }
      ]
    },
    "issuance/status": {
      "allOf": [
        {
          "$ref": "issuance-revocation-status.v1.schema.json"
        },
        {
          "properties": {
            "revoked_passport_ids": {
              "maxItems": 128
            }
          }
        }
      ],
      "description": "Exact signed status artifact for a V2 Messaging receive-consent handoff. Its serialized bytes are limited to 65536 by the carrier."
    }
  },
  "if": {
    "required": [
      "issuance/status"
    ]
  },
  "then": {
    "additionalProperties": false,
    "properties": {
      "schema": {},
      "passport": {
        "$ref": "capability-passport.v2.schema.json",
        "properties": {
          "capability_id": {
            "const": "messaging-receive"
          }
        }
      },
      "issuance/status": {}
    }
  }
}
