{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:membership-admission-policy:v1",
  "title": "membership-admission-policy.v1",
  "x-dia-status": "draft",
  "x-dia-workflow": "project",
  "x-dia-basis": [
    "doc/project/40-proposals/051-swarm-membership-and-reputation-bootstrap.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "membership-admission-policy.v1"
    },
    "policy/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "host/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "test-subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^participant:did:key:"
      }
    },
    "issuers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^participant:did:key:"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "controller": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "member",
                "sponsorship",
                "attestation",
                "covenant"
              ]
            }
          },
          "maximum-class": {
            "enum": [
              "guest",
              "contactable-participant",
              "sponsored-candidate",
              "probationary-member",
              "full-participant",
              "public-trust-role"
            ]
          }
        },
        "required": [
          "controller",
          "kinds",
          "maximum-class"
        ]
      }
    },
    "admitters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^participant:did:key:"
      }
    },
    "surface-policy": {
      "$ref": "surface-access-policy.v1.schema.json"
    },
    "controllers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "pattern": "^participant:did:key:"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "required": [
    "schema",
    "policy/id",
    "revision",
    "host/id",
    "test-subjects",
    "issuers",
    "admitters",
    "surface-policy",
    "controllers"
  ]
}
