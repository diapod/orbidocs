{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:whisper-case-adc-request:v1",
  "title": "whisper-case-adc-request.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case/anchor",
    "request/id",
    "condition/original",
    "command",
    "signer",
    "issued-at",
    "not-after",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "whisper-case-adc-request.v1"
    },
    "case/anchor": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "request/id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "condition/original": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "body"
          ],
          "properties": {
            "operation": {
              "const": "amendment"
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "others",
                "window_end",
                "release_end",
                "audiences",
                "mode"
              ],
              "properties": {
                "others": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "window_end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "release_end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "audiences": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  }
                },
                "mode": {
                  "enum": [
                    "confirm",
                    "preauthorized"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "withdrawal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "body"
          ],
          "properties": {
            "operation": {
              "const": "confirmation"
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "original",
                "audience",
                "trigger",
                "not_after"
              ],
              "properties": {
                "original": {
                  "type": "string",
                  "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
                },
                "audience": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "trigger": {
                  "type": "string",
                  "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
                },
                "not_after": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "body"
          ],
          "properties": {
            "operation": {
              "const": "release-commit"
            },
            "body": {
              "$ref": "#/$defs/intent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "body"
          ],
          "properties": {
            "operation": {
              "const": "abandonment"
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "intent",
                "receipt",
                "tombstone_at",
                "history_coverage"
              ],
              "properties": {
                "intent": {
                  "$ref": "#/$defs/intent"
                },
                "receipt": {
                  "$ref": "#/$defs/receipt"
                },
                "tombstone_at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "history_coverage": {
                  "type": "string",
                  "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
                }
              }
            }
          }
        }
      ]
    },
    "signer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "issued-at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30
    },
    "not-after": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "execution"
      ],
      "properties": {
        "intent": {
          "$ref": "whisper-release-intent.v1.schema.json"
        },
        "execution": {
          "$ref": "whisper-release-execution.v1.schema.json"
        }
      },
      "description": "Exact private executor-signed publication inputs. Required only for release-commit; the execution opening is never part of the Room release."
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original",
        "payload",
        "proof",
        "envelope_plan",
        "trigger",
        "audience",
        "executor",
        "route",
        "submission",
        "handover_by"
      ],
      "properties": {
        "original": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "payload": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "proof": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$",
          "description": "Digest of the exact public whisper-release-intent.v1 carried by publication; never a private observation or count digest."
        },
        "envelope_plan": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "trigger": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "handover_by": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "submission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "idempotency/key"
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "idempotency/key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "event_digest",
        "observed_count",
        "source_as_of"
      ],
      "properties": {
        "head": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_digest": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_as_of": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "operation": {
                "const": "release-commit"
              }
            },
            "required": [
              "operation"
            ]
          }
        }
      },
      "then": {
        "required": [
          "publication"
        ]
      },
      "else": {
        "not": {
          "required": [
            "publication"
          ]
        }
      }
    }
  ]
}
