          "$ref": "#/$defs/common/properties/witness~1node-id"
        },
        "accepted/at": {
          "$ref": "#/$defs/common/properties/accepted~1at"
        },
        "committed/at": {
          "$ref": "#/$defs/common/properties/committed~1at"
        },
        "outcome": {
          "$ref": "#/$defs/common/properties/outcome"
        },
        "witness/delegation-digest": {
          "$ref": "#/$defs/common/properties/witness~1delegation-digest"
        },
        "witness/delegation": {
