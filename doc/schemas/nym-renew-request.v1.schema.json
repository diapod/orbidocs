{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-renew-request:v1",
  "title": "NymRenewRequest v1",
  "description": "Participant-signed renewal request. Predecessor control is not a succession and does not bind the not-yet-issued successor certificate.",
  "type": "object",
  "additionalProperties": true,
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/20-memos/nym-layer-roadmap-and-revocable-anonymity.md",
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline.md"
  ],
  "required": [
    "schema/v",
    "request/id",
    "request/type",
    "participant/id",
    "created-at",
    "signature",
    "predecessor/certificate",
    "successor/nym",
    "issuer/id",
    "not-after",
    "predecessor/control-proof"
  ],
  "properties": {
    "schema/v": {
      "const": 1,
      "description": "Schema version."
    },
    "request/id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier of this renewal request.",
      "maxLength": 128
    },
    "request/type": {
      "const": "nym/renew",
      "description": "Application-level request discriminator."
    },
    "participant/id": {
      "type": "string",
      "pattern": "^participant:did:key:z[1-9A-HJ-NP-Za-km-z]+$",
      "description": "Participant identity asking for renewal."
    },
    "created-at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp of the renewal request.",
      "maxLength": 40
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "policy_annotations": {
      "type": "object",
      "additionalProperties": true
    },
    "predecessor/certificate": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "successor/nym": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^nym:did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "issuer/id": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^council:did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "not-after": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time"
    },
    "predecessor/control-proof": {
      "type": "string",
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "ed25519"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "succession"
        ]
      }
    }
  ]
}
