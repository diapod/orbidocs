{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:orbiplex:schema:nym-source-status-acquire.local:v2",
  "title": "nym-source-status-acquire.local.v2",
  "description": "Bounded status acquisition for an independently adopted v3 profile and exact v3 certificate. No caller clock, endpoint, profile adoption, key or issuance authority.",
  "required": [
    "profile/digest",
    "certificate",
    "purpose"
  ],
  "properties": {
    "profile/digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$",
      "minLength": 50,
      "maxLength": 50
    },
    "certificate": {
      "$ref": "whisper-source-certificate.v3.schema.json"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "collection",
        "first-emission"
      ]
    }
  }
}
