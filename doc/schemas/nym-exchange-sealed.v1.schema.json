{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-exchange-sealed:v1",
  "title": "nym-exchange-sealed.v1",
  "type": "object",
  "additionalProperties": false,
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "required": [
    "schema",
    "payload/schema",
    "recipient/key-ref",
    "sender/ephemeral-key",
    "nonce",
    "ciphertext",
    "exchange/handle"
  ],
  "properties": {
    "schema": {
      "enum": [
        "nym-key-request-sealed.v1",
        "nym-key-offer-sealed.v1",
        "nym-issuance-request-sealed.v1",
        "nym-issuance-decision-sealed.v1"
      ]
    },
    "payload/schema": {
      "enum": [
        "nym-exchange-key-request.v1",
        "nym-exchange-key-offer.v1",
        "nym-issuance-request.v1",
        "nym-issuance-decision.v1"
      ]
    },
    "recipient/key-ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "sender/ephemeral-key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_-]{32}$"
    },
    "ciphertext": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "exchange/handle": {
      "type": "string",
      "minLength": 52,
      "maxLength": 52,
      "pattern": "^exchange:[A-Za-z0-9_-]{43}$",
      "description": "Independent opaque 256-bit transport correlation; never the private signed request digest."
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema": {
          "const": "nym-key-request-sealed.v1"
        },
        "payload/schema": {
          "const": "nym-exchange-key-request.v1"
        }
      }
    },
    {
      "properties": {
        "schema": {
          "const": "nym-key-offer-sealed.v1"
        },
        "payload/schema": {
          "const": "nym-exchange-key-offer.v1"
        }
      }
    },
    {
      "properties": {
        "schema": {
          "const": "nym-issuance-request-sealed.v1"
        },
        "payload/schema": {
          "const": "nym-issuance-request.v1"
        }
      }
    },
    {
      "properties": {
        "schema": {
          "const": "nym-issuance-decision-sealed.v1"
        },
        "payload/schema": {
          "const": "nym-issuance-decision.v1"
        }
      }
    }
  ]
}
