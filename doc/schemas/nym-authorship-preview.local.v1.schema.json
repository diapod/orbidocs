{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-authorship-preview.local:v1",
  "title": "nym-authorship-preview.local.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile/digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "operation/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "certification/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "local-passphrase": {
      "type": "string",
      "maxLength": 4096,
      "writeOnly": true
    },
    "content": {
      "$ref": "whisper-signal-draft.local.v1.schema.json"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status-authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "not-after": {
          "type": "string",
          "format": "date-time",
          "maxLength": 30
        },
        "authority/policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5462,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Exact canonical signed whisper-case-authority-policy.v1 bytes as unpadded base64url; material alone grants no P091 admission."
        },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "description": "Explicit private release input. The source owner supplies commitments, independent random openings, case binding and signatures; never included in ordinary source readback.",
          "if": {"properties": {"custody": {"properties": {"mode": {"const": "held-under-obligation"}}}}},
          "then": {"required": ["custody/offers"], "properties": {"custody/offers": {"minProperties": 1}}},
          "else": {"properties": {"custody/offers": {"maxProperties": 0}}},
          "required": [
            "condition",
            "audiences",
            "executors",
            "custody",
            "payload/bytes"
          ],
          "properties": {
            "condition": {
              "$ref": "whisper-embargo-original.v1.schema.json#/properties/condition"
            },
            "audiences": {
              "$ref": "whisper-embargo-original.v1.schema.json#/properties/audiences"
            },
            "executors": {
              "$ref": "whisper-embargo-original.v1.schema.json#/properties/executors"
            },
            "custody": {
              "$ref": "whisper-embargo-original.v1.schema.json#/properties/custody"
            },
            "custody/offers": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {"maxLength": 48, "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"},
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 5462, "pattern": "^[A-Za-z0-9_-]+$"},
              "writeOnly": true,
              "description": "Exact private base64url PEX custody advertisements keyed by holder key. Held custody requires a current advertisement and local pin for every selected holder. Withheld custody carries no advertisements."
            },
            "source/detached": {
              "type": "boolean",
              "default": false,
              "description": "Select the detached source form. Explicit signing requires the exact embargo-manifest signing use in addition to the audience-manifest use."
            },
            "payload/bytes": {
              "type": "string",
              "maxLength": 87382,
              "pattern": "^[A-Za-z0-9_-]*$",
              "writeOnly": true,
              "description": "Exact release payload encoded as canonical unpadded base64url; the enclosing request and final carrier budgets also apply."
            }
          }
        }
      },
      "required": [
        "status-authority",
        "not-after",
        "authority/policy"
      ]
    }
  },
  "required": [
    "profile/digest",
    "operation/id",
    "certification/id",
    "content"
  ]
}
