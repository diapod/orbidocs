{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-authorship-preview.local:v1",
  "title": "nym-authorship-preview.local.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile/digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "operation/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "certification/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "local-passphrase": {
      "type": "string",
      "maxLength": 4096,
      "writeOnly": true
    },
    "content": {
      "$ref": "whisper-signal-draft.local.v1.schema.json"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status-authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "not-after": {
          "type": "string",
          "format": "date-time",
          "maxLength": 30
        },
        "authority/policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5462,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Exact canonical signed whisper-case-authority-policy.v1 bytes as unpadded base64url; material alone grants no P091 admission."
        }
      },
      "required": [
        "status-authority",
        "not-after",
        "authority/policy"
      ]
    }
  },
  "required": [
    "profile/digest",
    "operation/id",
    "certification/id",
    "content"
  ]
}
