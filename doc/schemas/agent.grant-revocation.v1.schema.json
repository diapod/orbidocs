{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:agent.grant-revocation:v1",
  "title": "Agent Grant Revocation Fact v1",
  "description": "Single durable authority-reduction fact; the prior session and binding facts remain unchanged.",
  "x-dia-workflow": "project",
  "x-dia-status": "accepted",
  "x-dia-basis": ["orbidocs:doc/project/40-proposals/073-agent-orchestration-organ.md"],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent/id", "capability/id", "idempotency/key", "request/digest", "result/state", "changed", "reason/code", "at", "by"],
  "properties": {
    "schema": {"const": "agent.grant-revocation.v1"},
    "agent/id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "capability/id": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotency/key": {"type": "string", "minLength": 1, "maxLength": 256},
    "request/digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$"},
    "result/state": {"enum": ["running", "suspended"]},
    "changed": {"type": "boolean"},
    "reason/code": {"type": "string", "minLength": 1, "maxLength": 256},
    "at": {"type": "string", "format": "date-time"},
    "by": {"type": "string", "minLength": 1}
  }
}
