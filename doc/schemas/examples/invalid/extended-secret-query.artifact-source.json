  },
  "admission/mode": "stage",
  "limits": {
    "carrier/bytes-max": 1048576,
    "candidates/max": 1,
    "candidate/bytes-max": 1048576,
    "duration/ms-max": 1000
  },
  "freshness/max-staleness-seconds": 900,
