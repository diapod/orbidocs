{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-issuer-consent.local:v1",
  "title": "nym-issuer-consent.local.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "peer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^node:did:key:z[1-9A-HJ-NP-Za-km-z]+$"
        },
        "family": {
          "enum": [
            "nym-key-request-sealed.v1",
            "nym-issuance-request-sealed.v1"
          ]
        },
        "artifact/id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifact/digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "peer",
        "family",
        "artifact/id",
        "artifact/digest"
      ]
    },
    "notification/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "offer",
    "notification/id"
  ]
}
