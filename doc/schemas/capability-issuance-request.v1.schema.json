{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:capability-issuance-request:v1",
  "title": "capability-issuance-request.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/076-limited-messaging-grants-decision.md",
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "capability-issuance-request.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^request:issuance:[A-Za-z0-9:_-]+$"
    },
    "federation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "participant_id": {
      "type": "string",
      "minLength": 21,
      "maxLength": 512,
      "pattern": "^participant:did:key:"
    },
    "node_id": {
      "type": "string",
      "minLength": 14,
      "maxLength": 512,
      "pattern": "^node:did:key:"
    },
    "delegate_key": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^did:key:"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "template": {
            "enum": [
              "local-send",
              "receive-consent",
              "inac-consent",
              "nym-bootstrap-consent"
            ]
          },
          "issuance_caller": {
            "enum": [
              "operator:messaging-prepare",
              "operator:contact-request.accept",
              "operator:inac.invitation.accept",
              "host:nym-bootstrap.accept"
            ]
          },
          "max_passport_ttl_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "template",
          "issuance_caller",
          "max_passport_ttl_seconds"
        ],
        "oneOf": [
          {
            "properties": {
              "template": {
                "const": "local-send"
              },
              "issuance_caller": {
                "const": "operator:messaging-prepare"
              }
            }
          },
          {
            "properties": {
              "template": {
                "const": "receive-consent"
              },
              "issuance_caller": {
                "const": "operator:contact-request.accept"
              }
            }
          },
          {
            "properties": {
              "template": {
                "const": "inac-consent"
              },
              "issuance_caller": {
                "const": "operator:inac.invitation.accept"
              }
            }
          },
          {
            "properties": {
              "template": {
                "const": "nym-bootstrap-consent"
              },
              "issuance_caller": {
                "const": "host:nym-bootstrap.accept"
              },
              "max_passport_ttl_seconds": {
                "maximum": 900
              }
            }
          }
        ]
      }
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "root_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "root_version": {
      "type": "integer",
      "minimum": 1
    },
    "signatures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alg",
          "key_public",
          "value"
        ],
        "properties": {
          "alg": {
            "const": "ed25519"
          },
          "key_public": {
            "type": "string",
            "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "request_id",
    "federation_id",
    "participant_id",
    "node_id",
    "delegate_key",
    "issued_at",
    "expires_at",
    "templates",
    "nonce",
    "root_digest",
    "root_version",
    "signatures"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "templates": {
            "contains": {
              "properties": {
                "template": {
                  "const": "nym-bootstrap-consent"
                }
              },
              "required": [
                "template"
              ]
            }
          }
        },
        "required": [
          "templates"
        ]
      },
      "then": {
        "properties": {
          "templates": {
            "maxItems": 1,
            "items": {
              "properties": {
                "template": {
                  "const": "nym-bootstrap-consent"
                },
                "issuance_caller": {
                  "const": "host:nym-bootstrap.accept"
                },
                "max_passport_ttl_seconds": {
                  "maximum": 900
                }
              }
            }
          }
        }
      }
    }
  ]
}
