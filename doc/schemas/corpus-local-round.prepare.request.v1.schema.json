{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:corpus-local-round.prepare.request:v1",
  "title": "corpus-local-round.prepare.request.v1",
  "type": "object",
  "additionalProperties": false,
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/069-corpus.md",
    "doc/project/40-proposals/094-operator-task-packs-for-bounded-problem-solving.md"
  ],
  "required": [
    "schema",
    "operator/binding-ref",
    "task-binding/ref",
    "problem/text",
    "participants"
  ],
  "properties": {
    "schema": {
      "const": "corpus-local-round.prepare.request.v1"
    },
    "operator/binding-ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^node-operator-binding:[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "task-binding/ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "problem/text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "$ref": "corpus-reasoning-room-policy.v3.schema.json#/$defs/room-subject"
      }
    },
    "topic/term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    }
  }
}
