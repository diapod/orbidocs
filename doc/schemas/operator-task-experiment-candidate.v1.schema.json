{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:operator-task-experiment-candidate:v1",
  "title": "Operator Task Experiment Candidate v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/094-operator-task-packs-for-bounded-problem-solving.md"
  ],
  "description": "Untrusted Agent or model output. Steps name closed action kinds and refs only; digests, capabilities, effect classes, HIL flags, binding identity, and activation generation are not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema/v",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "operator-task-experiment-candidate.v1"
    },
    "schema/v": {
      "const": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "operator-task-common.v1.schema.json#/$defs/candidateStep"
      }
    }
  }
}
