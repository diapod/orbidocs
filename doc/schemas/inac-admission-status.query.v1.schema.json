{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:inac-admission-status.query:v1",
  "title": "INAC exact-attempt admission query",
  "type": "object",
  "additionalProperties": false,
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/60-solutions/027-messaging-middleware/027-messaging-middleware.md#consent-loss-recovery"
  ],
  "required": [
    "schema",
    "idempotency/key",
    "artifact/id",
    "artifact/digest",
    "message/commitment",
    "resume/until"
  ],
  "properties": {
    "schema": {
      "const": "inac-admission-status.query.v1"
    },
    "idempotency/key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9:_.\\/-]+$"
    },
    "artifact/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9:_.\\/-]+$"
    },
    "artifact/digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "message/commitment": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "resume/until": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
