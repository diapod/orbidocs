    },
    "limits/requested": {
      "$ref": "middleware-channel-hello.v1.schema.json#/properties/limits~1requested"
    }
  },
  "$defs": {
    "id": {
      "$ref": "middleware-channel-hello.v1.schema.json#/$defs/id"
