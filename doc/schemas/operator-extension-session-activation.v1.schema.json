{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:orbiplex:schema:operator-extension-session-activation:v1",
  "title": "Operator Extension Session Activation V1", "type": "object", "additionalProperties": false,
  "required": ["schema", "schema/v", "activation/ref", "plan/ref", "plan/digest", "package/ref", "package/digest", "generation", "kind", "operational/class", "operator/binding-ref", "conformance/report-ref", "conformance/report-digest", "producers", "issued-at", "expires-at"],
  "properties": {
    "schema": {"const": "operator-extension-session-activation.v1"}, "schema/v": {"const": 1}, "activation/ref": {"$ref": "#/$defs/ref"}, "plan/ref": {"$ref": "#/$defs/ref"}, "plan/digest": {"$ref": "#/$defs/digest"}, "package/ref": {"$ref": "#/$defs/ref"}, "package/digest": {"$ref": "#/$defs/digest"}, "generation": {"type": "integer", "minimum": 1}, "kind": {"const": "session"}, "operational/class": {"type": "string", "enum": ["research", "experimental"]}, "operator/binding-ref": {"$ref": "#/$defs/ref"}, "conformance/report-ref": {"$ref": "#/$defs/ref"}, "conformance/report-digest": {"$ref": "#/$defs/digest"}, "producers": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/producer"}}, "issued-at": {"type": "string", "format": "date-time"}, "expires-at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"ref": {"type": "string", "minLength": 1, "maxLength": 256}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "producer": {"type": "object", "additionalProperties": false, "required": ["hook/id", "hook/v", "producer/ref", "producer/digest", "priority", "mode", "advisory/failure-allowed"], "properties": {"hook/id": {"$ref": "#/$defs/ref"}, "hook/v": {"type": "integer", "minimum": 1}, "producer/ref": {"$ref": "#/$defs/ref"}, "producer/digest": {"$ref": "#/$defs/digest"}, "priority": {"type": "integer", "minimum": 0, "maximum": 65535}, "mode": {"type": "string", "enum": ["required", "advisory"]}, "advisory/failure-allowed": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"mode": {"const": "required"}}, "required": ["mode"]}, "then": {"properties": {"advisory/failure-allowed": {"const": false}}}}]}},
