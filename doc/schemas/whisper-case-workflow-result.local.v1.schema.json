{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:whisper-case-workflow-result.local:v1",
  "title": "whisper-case-workflow-result.local.v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation/id",
        "phase",
        "exchange/handle",
        "reply/public-key"
      ],
      "properties": {
        "schema": {
          "const": "whisper-case-workflow-result.local.v1"
        },
        "operation/id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "phase": {
          "enum": [
            "preparing",
            "prepared",
            "transport-custody",
            "result-received"
          ]
        },
        "exchange/handle": {
          "type": "string",
          "pattern": "^exchange:[A-Za-z0-9_-]{43}$",
          "maxLength": 52
        },
        "reply/public-key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 43,
          "minLength": 43
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation/id",
        "phase",
        "delivery/id"
      ],
      "properties": {
        "schema": {
          "const": "whisper-case-workflow-result.local.v1"
        },
        "operation/id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "phase": {
          "const": "transport-custody"
        },
        "delivery/id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation/id",
        "result"
      ],
      "properties": {
        "schema": {
          "const": "whisper-case-workflow-result.local.v1"
        },
        "operation/id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "maxLength": 36
        },
        "result": {
          "oneOf": [
            {
              "$ref": "whisper-case-result.v1.schema.json"
            },
            {
              "$ref": "whisper-case-status.v1.schema.json"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reason",
        "retry"
      ],
      "properties": {
        "schema": {
          "const": "whisper-case-workflow-result.local.v1"
        },
        "reason": {
          "enum": [
            "access-denied",
            "request-id-conflict",
            "operation-budget-exhausted",
            "status-budget-exhausted",
            "structure",
            "limit",
            "binding",
            "signature",
            "authority-unavailable",
            "authority-kind-not-enabled",
            "stale-predecessor",
            "stale-status",
            "not-yet-valid",
            "terminal",
            "conflicted",
            "unresolved",
            "signing-policy-refused",
            "operation-not-enabled",
            "dependency-unavailable",
            "anchor-revoked-before-admission",
            "anchor-unproven",
            "owner-busy",
            "owner-material-limit",
            "owner-integrity-unavailable",
            "owner-dependency-unavailable",
            "owner-expired",
            "owner-binding",
            "owner-schema-unsupported"
          ]
        },
        "retry": {
          "enum": [
            "never",
            "evidence-change",
            "policy-change",
            "dependency-recovery",
            "at-deadline"
          ]
        }
      }
    }
  ]
}
