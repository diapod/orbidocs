{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:inference-policy.evaluate.response:v1",
  "title": "Inference Policy Evaluation Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assessments"
  ],
  "properties": {
    "schema": {
      "const": "inference-policy.evaluate.response.v1"
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject/ref",
          "decision"
        ],
        "properties": {
          "subject/ref": {
            "$ref": "inference-provenance-common.v1.schema.json#/$defs/ref"
          },
          "decision": {
            "enum": [
              "admit",
              "warn",
              "deny"
            ]
          }
        }
      }
    }
  }
}
