{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:agent.grant.revoke.response:v1",
  "title": "Agent Single Grant Revoke Response v1",
  "description": "Retained decision at the withdrawal boundary; state is the state when the fact was written.",
  "x-dia-workflow": "project",
  "x-dia-status": "accepted",
  "x-dia-basis": ["orbidocs:doc/project/40-proposals/073-agent-orchestration-organ.md"],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent/id", "capability/id", "state", "changed", "replayed", "reason/code"],
  "properties": {
    "schema": {"const": "agent.grant.revoke.response.v1"},
    "agent/id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "capability/id": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"enum": ["running", "suspended"]},
    "changed": {"type": "boolean"},
    "replayed": {"type": "boolean"},
    "reason/code": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
