{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:operator-experiment-package:v1",
  "title": "Operator Experiment Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema/v", "package/ref", "package/digest", "middleware-package/ref", "middleware-package/digest", "hooks", "required-capability/ids", "refusal-corpus/ref", "refusal-corpus/digest", "rollback/ref", "operational/class"],
  "properties": {
    "schema": {"const": "operator-experiment-package.v1"}, "schema/v": {"const": 1},
    "package/ref": {"$ref": "#/$defs/ref"}, "package/digest": {"$ref": "#/$defs/digest"},
    "middleware-package/ref": {"$ref": "#/$defs/ref"}, "middleware-package/digest": {"$ref": "#/$defs/digest"},
    "hooks": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/hook"}},
    "semantic-entries": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/semantic-entry"}, "default": []},
    "compatibility": {"$ref": "#/$defs/compatibility", "default": {}},
    "required-capability/ids": {"$ref": "#/$defs/refs"}, "resource-envelope/refs": {"$ref": "#/$defs/refs", "default": []},
    "derived-capability/refs": {"$ref": "#/$defs/refs", "default": []},
    "refusal-corpus/ref": {"$ref": "#/$defs/ref"}, "refusal-corpus/digest": {"$ref": "#/$defs/digest"},
    "rollback/ref": {"$ref": "#/$defs/ref"},
    "operational/class": {"type": "string", "enum": ["research", "experimental", "test", "production", "critical"]}
  },
  "anyOf": [
    {"properties": {"hooks": {"minItems": 1}}},
    {"required": ["semantic-entries"], "properties": {"semantic-entries": {"minItems": 1}}}
  ],
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 256}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "host/os": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}, "default": []},
        "host/arch": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}, "default": []}
      }
    },
    "hook": {"type": "object", "additionalProperties": false, "required": ["hook/id", "hook/v", "backend", "producer/ref", "producer/digest"], "properties": {"hook/id": {"$ref": "#/$defs/ref"}, "hook/v": {"type": "integer", "minimum": 1}, "backend": {"type": "string", "enum": ["table", "rhai"]}, "producer/ref": {"$ref": "#/$defs/ref"}, "producer/digest": {"$ref": "#/$defs/digest"}}},
    "semantic-entry": {"type": "object", "additionalProperties": false, "required": ["domain", "entry/ref", "entry/revision", "implementation/ref", "entry/digest"], "properties": {"domain": {"$ref": "#/$defs/ref"}, "entry/ref": {"$ref": "#/$defs/ref"}, "entry/revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "implementation/ref": {"$ref": "#/$defs/ref"}, "entry/digest": {"$ref": "#/$defs/semantic-digest"}}},
    "semantic-digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$"}
  },
  "x-dia-status": "accepted", "x-dia-basis": ["doc/project/40-proposals/085-operator-sovereign-extensibility-and-experiment-packages.md"]
}
