{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:whisper-embargo-release:v1",
  "title": "whisper-embargo-release.v1",
  "description": "Content of the executor-signed Agora release envelope. The statement carries its exact canonical bytes.",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-maximum-canonical-bytes": 49152,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent",
    "proof/package",
    "commit/statement"
  ],
  "properties": {
    "schema": {
      "const": "whisper-embargo-release.v1"
    },
    "intent": {
      "$ref": "whisper-release-intent.v1.schema.json"
    },
    "proof/package": {
      "$ref": "whisper-release-proof-package.v1.schema.json"
    },
    "commit/statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5462,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
