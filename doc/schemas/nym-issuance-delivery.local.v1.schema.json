{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-issuance-delivery.local:v1",
  "title": "nym-issuance-delivery.local.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nym-issuance-delivery.local.v1"
    },
    "operation/id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "minLength": 1,
      "maxLength": 128
    },
    "artifact/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifact/digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$",
      "minLength": 50,
      "maxLength": 50
    },
    "delivery/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "delivery/state": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "partial",
        "failed-retryable",
        "failed-permanent",
        "expired"
      ]
    },
    "issuance": {
      "$ref": "nym-issuance-readback.local.v1.schema.json"
    }
  },
  "required": [
    "schema",
    "operation/id",
    "artifact/id",
    "artifact/digest",
    "delivery/id",
    "delivery/state",
    "issuance"
  ]
}
