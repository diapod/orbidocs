{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/076-limited-messaging-grants-decision.md"
  ],
  "$id": "urn:orbiplex:schema:messaging-issuance-status.local:v1",
  "title": "messaging-issuance-status.local.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "messaging-issuance-status.local.v1"
    },
    "participant_id": {
      "type": "string",
      "pattern": "^participant:did:key:"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "grants": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "delegation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^delegation:issuance:[A-Za-z0-9:_-]+$"
          },
          "delegate_key": {
            "type": "string",
            "pattern": "^did:key:"
          },
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "ready",
              "blocked",
              "unknown"
            ]
          },
          "reasons": {
            "$ref": "messaging-send-decision.local.v2.schema.json#/properties/reasons"
          },
          "delegate_unlocked": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "status/as_of": {
            "type": "string",
            "format": "date-time"
          },
          "status/valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "passport_ids": {
            "type": "array",
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^passport:capability:"
            }
          },
          "withdrawn_passport_ids": {
            "description": "Locally withdrawn children of this grant. Withdrawal is effective locally at once; publication to the status authority is reported separately.",
            "type": "array",
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^passport:capability:"
            }
          },
          "withdrawal_publication_pending": {
            "description": "Withdrawn children whose signed withdrawal is not yet reflected by the grant's status authority.",
            "type": "array",
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^passport:capability:"
            }
          },
          "passports": {
            "description": "Public child inventory of this exact locally imported grant and bound owner/node. Peer observations are excluded. Authority observation, local withdrawal and publication are separate facts; GET performs no refresh, issuance or retry.",
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "passport_id": {
                  "$ref": "capability-passport.v2.schema.json#/properties/passport_id"
                },
                "capability_id": {
                  "$ref": "capability-passport.v2.schema.json#/properties/capability_id"
                },
                "profile": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "issued_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "scope": {
                  "$ref": "capability-passport.v2.schema.json#/properties/scope"
                },
                "status": {
                  "enum": [
                    "ready",
                    "blocked",
                    "unknown"
                  ]
                },
                "reasons": {
                  "$ref": "messaging-send-decision.local.v2.schema.json#/properties/reasons"
                },
                "locally_withdrawn": {
                  "type": "boolean"
                },
                "withdrawal_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^passport-revocation:"
                },
                "withdrawal_publication": {
                  "enum": [
                    "not-requested",
                    "pending",
                    "confirmed",
                    "covered-by-parent"
                  ],
                  "description": "An authenticated explicit child acknowledgement confirms publication. An authenticated revoked parent covers an unpublished child withdrawal separately; an expired status lease does not erase either fact."
                },
                "allowed_actions": {
                  "type": "array",
                  "maxItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "const": "withdraw"
                  }
                }
              },
              "required": [
                "passport_id",
                "capability_id",
                "profile",
                "issued_at",
                "expires_at",
                "scope",
                "status",
                "reasons",
                "locally_withdrawn",
                "withdrawal_id",
                "withdrawal_publication",
                "allowed_actions"
              ]
            }
          },
          "passport_total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024,
            "description": "Total locally issued children of this exact grant before window/point selection."
          }
        },
        "required": [
          "delegation_id",
          "delegate_key",
          "key_id",
          "expires_at",
          "status",
          "reasons",
          "delegate_unlocked",
          "revision",
          "status/as_of",
          "status/valid_until",
          "passport_ids",
          "withdrawn_passport_ids",
          "withdrawal_publication_pending",
          "passports"
        ]
      }
    },
    "consent_window": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional host-selected global window. Child IDs and withdrawal lists in each grant refer only to the selected window; passport_total counts all local children. No off-window scopes are serialized.",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "page_size": {
          "const": 25
        },
        "previous_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 40
        },
        "next_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 40
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      },
      "required": [
        "page",
        "page_size",
        "previous_page",
        "next_page",
        "total"
      ]
    }
  },
  "required": [
    "schema",
    "participant_id",
    "observed_at",
    "grants"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "consent_window"
        ]
      },
      "then": {
        "properties": {
          "grants": {
            "items": {
              "required": [
                "passport_total"
              ],
              "properties": {
                "passports": {
                  "maxItems": 25
                },
                "passport_ids": {
                  "maxItems": 25
                },
                "withdrawn_passport_ids": {
                  "maxItems": 25
                },
                "withdrawal_publication_pending": {
                  "maxItems": 25
                }
              }
            }
          }
        }
      }
    }
  ]
}
