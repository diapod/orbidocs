{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:whisper-adc-author-basis-reply:v1",
  "title": "whisper-adc-author-basis-reply.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-maximum-canonical-bytes": 4096,
  "description": "Private authority-signed readback bound to one author request and proposal. A null current minimum denotes an audience removed by a narrowing. An unavailable response carries no basis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case/authority",
    "request/digest",
    "proposal/digest",
    "observed/at",
    "state",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "whisper-adc-author-basis-reply.v1"
    },
    "case/authority": {
      "type": "string",
      "pattern": "^node:did:key:z[1-9A-HJ-NP-Za-km-z]+$",
      "maxLength": 144
    },
    "request/digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "proposal/digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "observed/at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "state": {
      "enum": [
        "as-proposed",
        "superseded-by-narrowing",
        "unavailable"
      ]
    },
    "proposal/head": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "current/head": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "proposal/required-others": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "current/required-others": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "state": {
          "enum": [
            "as-proposed",
            "superseded-by-narrowing"
          ]
        }
      },
      "required": [
        "proposal/head",
        "current/head",
        "proposal/required-others",
        "current/required-others"
      ]
    },
    {
      "properties": {
        "state": {
          "const": "unavailable"
        },
        "proposal/head": false,
        "current/head": false,
        "proposal/required-others": false,
        "current/required-others": false
      }
    }
  ]
}
