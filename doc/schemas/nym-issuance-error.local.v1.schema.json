{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-issuance-error.local:v1",
  "title": "nym-issuance-error.local.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nym-issuance-error.local.v1"
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "authority/reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "unlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rel": {
          "const": "unlock-delegate"
        },
        "method": {
          "const": "POST"
        },
        "href": {
          "const": "/v1/identity/messaging-issuance/unlock"
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "rel",
        "method",
        "href",
        "delegation_id"
      ]
    }
  },
  "required": [
    "schema",
    "field",
    "reason"
  ]
}
