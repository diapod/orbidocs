  "required": [
    "schema",
    "profile",
    "run/id",
    "host/id",
    "host/incarnation",
    "node",
    "orbidocs",
    "binaries",
    "policy",
    "grants",
    "fixtures/digest",
    "configuration/digest",
    "toolchain/digest",
    "qualifier/digest",
    "profile/digest",
    "schemas/digest",
    "scenarios",
    "budget",
    "safety",
    "validator/digest"
  ]
}
