{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:nym-bootstrap-authority-result.local:v1",
  "title": "nym-bootstrap-authority-result.local.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request": {
      "allOf": [
        {
          "$ref": "capability-issuance-request.v1.schema.json"
        },
        {
          "properties": {
            "templates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "template": {
                    "const": "nym-bootstrap-consent"
                  },
                  "issuance_caller": {
                    "const": "host:nym-bootstrap.accept"
                  },
                  "max_passport_ttl_seconds": {
                    "minimum": 1,
                    "maximum": 900
                  }
                }
              }
            }
          }
        }
      ]
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "request",
    "key_id"
  ]
}
