{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:sensorium-web-refresh-claim:v1",
  "title": "Sensorium Web Refresh Claim v1",
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\s\\u0000]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$" }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema/v", "status"],
      "properties": {
        "schema": { "const": "sensorium-web-refresh-claim.v1" },
        "schema/v": { "const": 1 },
        "status": { "const": "idle" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema/v", "status", "source/ref", "source/generation-ref", "source/operation-id", "request/digest", "timeout/ms"],
      "properties": {
        "schema": { "const": "sensorium-web-refresh-claim.v1" },
        "schema/v": { "const": 1 },
        "status": { "const": "claimed" },
        "source/ref": { "$ref": "#/$defs/ref" },
        "source/generation-ref": { "$ref": "#/$defs/ref" },
        "source/operation-id": { "$ref": "#/$defs/ref" },
        "request/digest": { "$ref": "#/$defs/digest" },
        "timeout/ms": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    }
  ]
}
