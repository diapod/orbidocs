{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "$id": "urn:orbiplex:schema:nym-exchange-key-request:v1",
  "title": "nym-exchange-key-request.v1",
  "properties": {
    "schema": {
      "const": "nym-exchange-key-request.v1"
    },
    "issuer/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^council:did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "profile/digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "reply/key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "issued/at": {
      "type": "string",
      "format": "date-time"
    },
    "expires/at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "exchange/handle": {
      "type": "string",
      "minLength": 52,
      "maxLength": 52,
      "pattern": "^exchange:[A-Za-z0-9_-]{43}$",
      "description": "Independent opaque 256-bit transport correlation; never the private signed request digest."
    },
    "bootstrap/key-public": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$",
      "description": "Domain-separated ephemeral Ed25519 bootstrap proof key; not the participant or nym public key."
    }
  },
  "required": [
    "schema",
    "issuer/id",
    "profile/digest",
    "reply/key",
    "issued/at",
    "expires/at",
    "signature",
    "exchange/handle",
    "bootstrap/key-public"
  ]
}
