{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:weak-signal-original-read.local:v1",
  "title": "weak-signal-original-read.local.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding/id",
    "claim/id",
    "classification",
    "offset/bytes",
    "length/bytes"
  ],
  "properties": {
    "finding/id": {
      "type": "string",
      "pattern": "^finding:[A-Za-z0-9._:-]{6,160}$"
    },
    "claim/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000]+$"
    },
    "classification": {
      "$ref": "classification.v1.schema.json"
    },
    "offset/bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "length/bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 524288
    }
  }
}
