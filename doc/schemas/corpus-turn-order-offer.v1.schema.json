{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:corpus-turn-order-offer:v1",
  "title": "Corpus Turn Order Offer v1",
  "description": "Host-built immutable and target-free candidate projection for one exact Corpus Room turn.",
  "x-dia-workflow": "project",
  "x-dia-status": "accepted",
  "x-dia-basis": ["doc/project/40-proposals/069-corpus.md"],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema/v", "offer/ref", "offer/digest", "query/id", "room/id", "round/id",
    "turn/no", "room-policy/ref", "room-policy/digest", "room-policy/generation",
    "chair-policy/ref", "chair-policy/digest", "membership/high-water-seq-no",
    "sanction/high-water-seq-no", "candidates", "created-at", "expires-at"
  ],
  "properties": {
    "schema": { "const": "corpus-turn-order-offer.v1" },
    "schema/v": { "const": 1 },
    "offer/ref": { "type": "string", "pattern": "^corpus-turn-order-offer:sha256:[A-Za-z0-9_-]{43}$" },
    "offer/digest": { "$ref": "#/$defs/digest" },
    "query/id": { "type": "string", "pattern": "^query:[^\\s]+$", "maxLength": 512 },
    "room/id": { "type": "string", "pattern": "^room:[^\\s]+$", "maxLength": 512 },
    "round/id": { "type": "string", "pattern": "^round:[^\\s]+$", "maxLength": 512 },
    "turn/no": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "previous-floor-holder": { "$ref": "corpus-reasoning-room-policy.v1.schema.json#/$defs/room-subject" },
    "room-policy/ref": { "$ref": "#/$defs/ref" },
    "room-policy/digest": { "$ref": "#/$defs/digest" },
    "room-policy/generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "chair-policy/ref": { "type": "string", "pattern": "^corpus-chair-control-policy:[^\\s]+$", "maxLength": 512 },
    "chair-policy/digest": { "$ref": "#/$defs/digest" },
    "membership/high-water-seq-no": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sanction/high-water-seq-no": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "created-at": { "type": "string", "format": "date-time" },
    "expires-at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[!-~]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate/ref", "participant", "role", "role-assignment/ref",
        "role-assignment/revision", "role-assignment/digest"
      ],
      "properties": {
        "candidate/ref": { "type": "string", "pattern": "^corpus-turn-order-candidate:sha256:[A-Za-z0-9_-]{43}$" },
        "participant": { "$ref": "corpus-reasoning-room-policy.v1.schema.json#/$defs/room-subject" },
        "role": { "enum": ["implementer", "reviewer", "adversarial-critic", "summarizer"] },
        "role-assignment/ref": { "type": "string", "pattern": "^corpus-role-assignment:sha256:[A-Za-z0-9_-]{43}$" },
        "role-assignment/revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "role-assignment/digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
