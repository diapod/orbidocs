{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:weak-signal-custody-extend.local:v1",
  "title": "weak-signal-custody-extend.local.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding/id",
    "expected/claims",
    "retention/seconds",
    "idempotency/key"
  ],
  "properties": {
    "finding/id": {
      "type": "string",
      "pattern": "^finding:[A-Za-z0-9._:-]{6,160}$"
    },
    "expected/claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "generation",
          "body-digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\s\\u0000]+$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "body-digest": {
            "type": "string",
            "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
          }
        }
      }
    },
    "retention/seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2592000
    },
    "idempotency/key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\s\\u0000]+$"
    }
  }
}
