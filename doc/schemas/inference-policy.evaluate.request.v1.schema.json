{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:inference-policy.evaluate.request:v1",
  "title": "Inference Policy Evaluation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "at",
    "subjects"
  ],
  "properties": {
    "schema": {
      "const": "inference-policy.evaluate.request.v1"
    },
    "policy": {
      "$ref": "inference-consumption-policy.v1.schema.json"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject/ref",
          "evidence"
        ],
        "properties": {
          "subject/ref": {
            "$ref": "inference-provenance-common.v1.schema.json#/$defs/ref"
          },
          "evidence": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "posture"
                ],
                "properties": {
                  "kind": {
                    "const": "declared"
                  },
                  "posture": {
                    "anyOf": [
                      {
                        "$ref": "inference-execution-posture.v1.schema.json"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "provenance"
                ],
                "properties": {
                  "kind": {
                    "const": "realized"
                  },
                  "provenance": {
                    "anyOf": [
                      {
                        "$ref": "inference-execution-provenance.v1.schema.json#/$defs/descriptor"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
