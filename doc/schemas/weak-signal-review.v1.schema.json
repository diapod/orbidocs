{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:weak-signal-review:v1",
  "title": "weak-signal-review.v1",
  "x-dia-basis": [
    "doc/project/40-proposals/078-weak-signal-harvester.md",
    "doc/project/40-proposals/084-sensorium-web-observation-connector.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review/id",
    "reviewed/by",
    "reviewed/at",
    "review/revision",
    "review/request",
    "material/findings",
    "custody/claims",
    "origin",
    "execution/receipt"
  ],
  "properties": {
    "schema": {
      "const": "weak-signal-review.v1"
    },
    "review/id": {
      "type": "string",
      "pattern": "^weak-signal-review:[a-f0-9]{64}$"
    },
    "reviewed/by": {
      "const": "operator:local-control"
    },
    "reviewed/at": {
      "type": "string",
      "format": "date-time"
    },
    "review/revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "review/request": {
      "$ref": "#/$defs/request"
    },
    "material/findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding/id",
          "source/finding-digest"
        ],
        "properties": {
          "finding/id": {
            "type": "string",
            "pattern": "^finding:[A-Za-z0-9._:-]{6,160}$"
          },
          "source/finding-digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "custody/claims": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner/component-id",
          "claim",
          "snapshot/ref",
          "role",
          "classification"
        ],
        "properties": {
          "owner/component-id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\s\\u0000]+$"
          },
          "claim": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "generation",
              "body-digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\s\\u0000]+$"
              },
              "generation": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "body-digest": {
                "type": "string",
                "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
              }
            }
          },
          "snapshot/ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\s\\u0000]+$"
          },
          "role": {
            "enum": [
              "original",
              "representation"
            ]
          },
          "classification": {
            "$ref": "classification.v1.schema.json"
          }
        }
      }
    },
    "origin": {
      "$ref": "whisper-origin.v1.schema.json"
    },
    "execution/receipt": {
      "$ref": "execution-receipt.v1.schema.json"
    }
  },
  "description": "Immutable local review with exact admitted material inventory and private claim bindings. A review grants no publication authority. Owner checks bytes, current custody and lineage; summary contains no raw refs or horizons.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding/id",
        "source/finding-digest",
        "outcome",
        "create/whisper-draft",
        "expected/review-revision"
      ],
      "properties": {
        "finding/id": {
          "type": "string",
          "pattern": "^finding:[A-Za-z0-9._:-]{6,160}$"
        },
        "source/finding-digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected",
            "archived"
          ]
        },
        "create/whisper-draft": {
          "type": "boolean"
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary/redacted",
            "topic/class",
            "signal/polarity"
          ],
          "properties": {
            "summary/redacted": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "topic/class": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "signal/polarity": {
              "enum": [
                "problem",
                "idea",
                "question",
                "context",
                "mixed"
              ]
            }
          }
        },
        "expected/review-revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "material/findings": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding/id",
              "source/finding-digest"
            ],
            "properties": {
              "finding/id": {
                "type": "string",
                "pattern": "^finding:[A-Za-z0-9._:-]{6,160}$"
              },
              "source/finding-digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "description": "Additional admitted findings, a semantic set sorted by finding/id. The primary finding is included by the owner and must not be repeated."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "redaction"
            ]
          },
          "else": {
            "properties": {
              "create/whisper-draft": {
                "const": false
              }
            },
            "not": {
              "required": [
                "redaction"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "create/whisper-draft"
            ],
            "properties": {
              "create/whisper-draft": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "redaction": {
                "properties": {
                  "signal/polarity": {
                    "enum": [
                      "problem",
                      "idea"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "custody-claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner/component-id",
        "claim",
        "snapshot/ref",
        "role",
        "classification"
      ],
      "properties": {
        "owner/component-id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\s\\u0000]+$"
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "generation",
            "body-digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\s\\u0000]+$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "body-digest": {
              "type": "string",
              "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
            }
          }
        },
        "snapshot/ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000]+$"
        },
        "role": {
          "enum": [
            "original",
            "representation"
          ]
        },
        "classification": {
          "$ref": "classification.v1.schema.json"
        }
      }
    }
  }
}
