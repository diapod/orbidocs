{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:operator-attention-budget:v1",
  "title": "Operator Attention Budget V1",
  "description": "Signed local budget for bounded human-in-the-loop prompts. Exhaustion can only group, defer, deny, or surface security visibility.",
  "x-dia-workflow": "project", "x-dia-status": "accepted",
  "x-dia-basis": ["doc/project/40-proposals/085-operator-sovereign-extensibility-and-experiment-packages.md"],
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema/v", "budget/ref", "revision/no", "request/classes", "timezone", "availability/windows", "window/seconds", "prompts/max", "group/max-items", "repeat/min-seconds", "request/timeout-seconds", "outside-window", "overflow", "operator/binding-ref", "issued-at", "expires-at", "signature"],
  "properties": {
    "schema": {"const": "operator-attention-budget.v1"}, "schema/v": {"const": 1},
    "budget/ref": {"type": "string", "pattern": "^operator-attention-budget:[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 256},
    "revision/no": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "request/classes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["effect-consent", "package-activation", "authority-change", "security-notice"]}},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 128},
    "availability/windows": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["weekdays", "start/minute", "end/minute"], "properties": {"weekdays": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}}, "start/minute": {"type": "integer", "minimum": 0, "maximum": 1439}, "end/minute": {"type": "integer", "minimum": 1, "maximum": 1440}}}},
    "window/seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "prompts/max": {"type": "integer", "minimum": 1, "maximum": 4096},
    "group/max-items": {"type": "integer", "minimum": 1, "maximum": 4096},
    "repeat/min-seconds": {"type": "integer", "minimum": 0, "maximum": 604800},
    "request/timeout-seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "outside-window": {"enum": ["defer", "deny"]}, "overflow": {"enum": ["group", "defer", "deny"]},
    "operator/binding-ref": {"type": "string", "pattern": "^node-operator-binding:[a-z0-9][a-z0-9:-]*$", "maxLength": 256},
    "issued-at": {"type": "string", "format": "date-time"}, "expires-at": {"type": "string", "format": "date-time"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {"signature": {"type": "object", "additionalProperties": false, "required": ["alg", "key/public", "value"], "properties": {"alg": {"const": "ed25519+domain-v1"}, "key/public": {"type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]{20,120}$"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}}}
}
