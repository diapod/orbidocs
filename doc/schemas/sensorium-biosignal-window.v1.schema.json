{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:sensorium-biosignal-window:v1",
  "title": "sensorium-biosignal-window.v1",
  "description": "Transient synthetic window, grouped by independent preset. Min/max summarize present samples in the retained monotonic window; they are neither contact quality nor a feature recipe. Evictions count source blocks, not SDK losses. No physical sensing latency or continuity is inferred.",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": ["doc/project/40-proposals/096-sensorium-brainflow-connector.md"],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema/v", "evidence/class", "quality", "position", "retained/bytes", "retained/high-water-bytes", "evicted/blocks", "streams"],
  "properties": {
    "schema": {"const": "sensorium-biosignal-window.v1"},
    "schema/v": {"const": 1},
    "evidence/class": {"const": "synthetic"},
    "quality": {"const": "unknown"},
    "position": {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "retained/bytes": {"type": "integer", "minimum": 0, "maximum": 524288},
    "retained/high-water-bytes": {"type": "integer", "minimum": 0, "maximum": 524288},
    "evicted/blocks": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "streams": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stream/id", "samples", "channels"],
        "properties": {
          "stream/id": {"type": "string", "minLength": 1, "maxLength": 128},
          "samples": {"type": "integer", "minimum": 1, "maximum": 4096},
          "channels": {
            "type": "array", "minItems": 1, "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "present", "min", "max"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 128},
                "present": {"type": "integer", "minimum": 0, "maximum": 4096},
                "min": {"type": ["number", "null"]},
                "max": {"type": ["number", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
