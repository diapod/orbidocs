{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbiplex.ai/scheduled-module-job-request.v1.schema.json",
  "title": "scheduled-module-job-request.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "scheduled-module-job-request.v1"
    },
    "job/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "launch/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner/module-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scheduled/for-ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "started/at-ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "budget/remaining-ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000,
      "description": "Upper bound in milliseconds for the module response and all launch-owned work. The module MUST finish before this budget expires, including child cleanup. A host timeout does not establish cancellation or absence of effects."
    }
  },
  "required": [
    "schema",
    "job/id",
    "launch/id",
    "owner/module-id",
    "operation",
    "scheduled/for-ms",
    "started/at-ms",
    "budget/remaining-ms"
  ]
}
