{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:whisper-source-profile:v2",
  "title": "whisper-source-profile.v2",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "x-dia-basis": [
    "doc/project/40-proposals/015-nym-certificates-and-renewal-baseline/contextual-whisper-authorship.md"
  ],
  "required": [
    "schema",
    "profile/kind",
    "federation/id",
    "issuer/id",
    "epoch/anchor",
    "source/derivation",
    "renewal/default",
    "key/active-limit",
    "renewal/consent-limit",
    "clock/skew-seconds",
    "epoch/seconds",
    "certificate/ttl-seconds",
    "request/ttl-seconds",
    "status/collection-max-age-seconds",
    "status/emission-max-age-seconds",
    "retention/identifying-seconds",
    "retention/reset-buffer-seconds",
    "retention/tombstone-seconds",
    "epoch/certificate-limit",
    "publication/matrix-time-policy",
    "publication/sqlite-time-policy",
    "source/activation-policy",
    "receipt/key-window-seconds",
    "receipt/commit-budget-seconds",
    "scope/authorized-uses"
  ],
  "properties": {
    "schema": {
      "const": "whisper-source-profile.v2"
    },
    "profile/kind": {
      "enum": [
        "production",
        "acceptance-fixture"
      ]
    },
    "federation/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issuer/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^council:did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "epoch/anchor": {
      "const": "1970-01-05T00:00:00Z"
    },
    "source/derivation": {
      "const": "issuer-derived-v1"
    },
    "renewal/default": {
      "const": "on-demand"
    },
    "key/active-limit": {
      "const": 4096
    },
    "renewal/consent-limit": {
      "const": 7
    },
    "clock/skew-seconds": {
      "const": 5
    },
    "epoch/seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "certificate/ttl-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "request/ttl-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "status/collection-max-age-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "status/emission-max-age-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "retention/identifying-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "retention/reset-buffer-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "retention/tombstone-seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "epoch/certificate-limit": {
      "const": 2048
    },
    "publication/matrix-time-policy": {
      "const": "authenticated-admitted-homeserver-v1"
    },
    "publication/sqlite-time-policy": {
      "const": "witnessed-admission-receipt-v1"
    },
    "source/activation-policy": {
      "const": "post-reset-collection-drain-v1"
    },
    "receipt/key-window-seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "receipt/commit-budget-seconds": {
      "const": 5
    },
    "scope/authorized-uses": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record/kind",
          "content/schema",
          "topic/key",
          "disclosure/scope",
          "signing/use"
        ],
        "properties": {
          "record/kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "content/schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "topic/key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "disclosure/scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "signing/use": {
            "enum": [
              "publication",
              "embargo-manifest"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile/kind": {
            "const": "production"
          }
        },
        "required": [
          "profile/kind"
        ]
      },
      "then": {
        "properties": {
          "epoch/seconds": {
            "const": 604800
          },
          "certificate/ttl-seconds": {
            "const": 86400
          },
          "request/ttl-seconds": {
            "const": 900
          },
          "status/collection-max-age-seconds": {
            "const": 3600
          },
          "status/emission-max-age-seconds": {
            "const": 300
          },
          "retention/identifying-seconds": {
            "const": 86400
          },
          "retention/reset-buffer-seconds": {
            "const": 300
          },
          "retention/tombstone-seconds": {
            "const": 604800
          },
          "receipt/key-window-seconds": {
            "const": 3600
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile/kind": {
            "const": "acceptance-fixture"
          }
        },
        "required": [
          "profile/kind"
        ]
      },
      "then": {
        "properties": {
          "epoch/seconds": {
            "const": 600
          },
          "certificate/ttl-seconds": {
            "const": 120
          },
          "request/ttl-seconds": {
            "const": 60
          },
          "status/collection-max-age-seconds": {
            "const": 60
          },
          "status/emission-max-age-seconds": {
            "const": 30
          },
          "retention/identifying-seconds": {
            "const": 60
          },
          "retention/reset-buffer-seconds": {
            "const": 10
          },
          "retention/tombstone-seconds": {
            "const": 600
          },
          "receipt/key-window-seconds": {
            "const": 60
          }
        }
      }
    }
  ]
}
