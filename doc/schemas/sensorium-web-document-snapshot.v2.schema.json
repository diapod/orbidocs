{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:sensorium-web-document-snapshot:v2",
  "title": "sensorium-web-document-snapshot.v2",
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema/v",
    "snapshot/id",
    "source/ref",
    "source/generation-ref",
    "requested-url/digest",
    "final-url/digest",
    "fetched/at",
    "response/status",
    "media/type",
    "body/digest",
    "fetch/result-digest",
    "extraction/profile-ref",
    "extraction/profile-digest",
    "representation/digest",
    "operational/context",
    "classification",
    "causal/context",
    "custody/owner",
    "custody/claims",
    "representation/artifact-ref"
  ],
  "properties": {
    "schema": {
      "const": "sensorium-web-document-snapshot.v2"
    },
    "schema/v": {
      "const": 2
    },
    "snapshot/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source/ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source/generation-ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requested-url/display": {
      "type": "string",
      "maxLength": 4096
    },
    "requested-url/digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "final-url/display": {
      "type": "string",
      "maxLength": 4096
    },
    "final-url/digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "fetched/at": {
      "type": "string",
      "format": "date-time"
    },
    "response/status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "media/type": {
      "enum": [
        "text/html",
        "application/xhtml+xml",
        "text/plain"
      ]
    },
    "declared/charset": {
      "type": "string",
      "maxLength": 64
    },
    "selected/charset": {
      "type": "string",
      "maxLength": 64
    },
    "body/bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "body/digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "fetch/result-digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "extraction/profile-ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "extraction/profile-digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "representation/digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "representation/artifact-ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "title": {
      "type": "string",
      "maxLength": 1024
    },
    "byline": {
      "type": "string",
      "maxLength": 512
    },
    "language/claim": {
      "type": "string",
      "maxLength": 64
    },
    "operational/context": {
      "$ref": "sensorium-operational-context.v1.schema.json"
    },
    "classification": {
      "$ref": "classification.v1.schema.json"
    },
    "causal/context": {
      "$ref": "causal-context.v1.schema.json"
    },
    "custody/owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000]+$"
    },
    "custody/claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original",
        "representation"
      ],
      "properties": {
        "original": {
          "$ref": "artifact-delivery-retain-result.v2.schema.json"
        },
        "representation": {
          "$ref": "artifact-delivery-retain-result.v2.schema.json"
        }
      }
    }
  }
}
