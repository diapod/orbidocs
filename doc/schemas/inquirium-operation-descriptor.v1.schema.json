{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:inquirium-operation-descriptor:v1",
  "title": "Inquirium Operation Descriptor v1",
  "description": "Domain-owned code-backed descriptor for one closed Inquirium operation.",
  "x-dia-workflow": "project",
  "x-dia-status": "accepted",
  "x-dia-basis": ["doc/project/60-solutions/044-inquirium/044-inquirium.md", "doc/project/40-proposals/064-inquirium-implementation-recommendations.md", "doc/project/40-proposals/085-operator-sovereign-extensibility-and-experiment-packages.md"],
  "type": "object",
  "additionalProperties": false,
  "required": ["entry/ref", "entry/revision", "implementation/ref", "request/schema-ref", "response/schema-ref", "required/capability-ids", "constraints", "provenance", "digest"],
  "properties": {
    "entry/ref": { "type": "string", "pattern": "^inquirium-operation:[a-z][a-z0-9-]{0,126}-v[1-9][0-9]*$" },
    "entry/revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "implementation/ref": { "type": "string", "pattern": "^inquirium\\.handler\\.[a-z][a-z0-9-]{0,127}$" },
    "request/schema-ref": { "$ref": "#/$defs/id" },
    "response/schema-ref": { "$ref": "#/$defs/id" },
    "required/capability-ids": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "deferred", "requires/model-runtime", "authority/source", "opens-operation-algebra"],
      "properties": {
        "operation": { "enum": ["generate", "embed", "batch.embed", "classify", "rerank", "summarize", "transform", "image.generate", "image.edit", "train.adapt"] },
        "deferred": { "type": "boolean" },
        "requires/model-runtime": { "const": true },
        "authority/source": { "enum": ["host-capability", "operator-control-plane"] },
        "opens-operation-algebra": { "const": false }
      }
    },
    "provenance": { "enum": ["distribution-default", "operator-package"] },
    "package/ref": { "$ref": "#/$defs/id" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    { "if": { "properties": { "provenance": { "const": "operator-package" } }, "required": ["provenance"] }, "then": { "required": ["package/ref"] } },
    { "if": { "properties": { "provenance": { "const": "distribution-default" } }, "required": ["provenance"] }, "then": { "not": { "required": ["package/ref"] } } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]*[A-Za-z0-9]$|^[A-Za-z0-9]$" },
    "digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$" }
  }
}
