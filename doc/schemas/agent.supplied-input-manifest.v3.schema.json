{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:agent.supplied-input-manifest:v3",
  "title": "agent.supplied-input-manifest.v3",
  "description": "P026-012b-r1 successor. Historical versions are unchanged; private commitments have explicit HMAC labels.",
  "x-dia-workflow": "project",
  "x-dia-status": "accepted",
  "x-dia-basis": [
    "doc/project/40-proposals/026-assessment-agent-consumer-r1.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest/ref",
    "agent/id",
    "agent-binding/ref",
    "passage/ref",
    "request/ref",
    "request/digest",
    "context/authority-dependencies",
    "inputs"
  ],
  "properties": {
    "schema": {
      "const": "agent.supplied-input-manifest.v3"
    },
    "manifest/ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "agent/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "agent-binding/ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "passage/ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request/ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request/digest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "context/authority-dependencies": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input/ref",
          "content/digest",
          "context/authority-dependencies"
        ],
        "properties": {
          "input/ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "content/digest": {
            "type": "string",
            "pattern": "^(sha256:([A-Za-z0-9_-]{43}|[0-9a-fA-F]{64})|hmac-sha256:[0-9a-f]{64})$"
          },
          "context/authority-dependencies": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
