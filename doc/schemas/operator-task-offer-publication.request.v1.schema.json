{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:operator-task-offer-publication.request:v1",
  "title": "operator task offer publication.request v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/094-operator-task-packs-for-bounded-problem-solving.md"
  ],
  "description": "Explicit current-operator approval of one retained exact draft, or withdrawal of its ordinary offer. It never accepts replacement draft or offer bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema/v",
    "draft/ref",
    "action",
    "operator/binding-ref",
    "local-binding/expected-digest"
  ],
  "properties": {
    "schema": {
      "const": "operator-task-offer-publication.request.v1"
    },
    "schema/v": {
      "const": 1
    },
    "draft/ref": {
      "$ref": "operator-task-common.v1.schema.json#/$defs/ref"
    },
    "action": {
      "enum": [
        "publish",
        "withdraw"
      ]
    },
    "operator/binding-ref": {
      "$ref": "operator-task-common.v1.schema.json#/$defs/ref"
    },
    "local-binding/expected-digest": {
      "$ref": "operator-task-common.v1.schema.json#/$defs/digest"
    }
  }
}
