{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:agora-matrix-recovery-retry-batch-request:v1",
  "title": "agora-matrix-recovery-retry-batch-request.v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": [
    "doc/project/40-proposals/035-agora-topic-addressed-record-relay.md"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request/id",
    "items"
  ],
  "properties": {
    "request/id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "source/id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "operator_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_ref",
          "expected_revision"
        ],
        "properties": {
          "task_ref": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      }
    }
  }
}
