{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:artifact-delivery-extend-result:v1",
  "title": "artifact-delivery-extend-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcome",
    "extension"
  ],
  "properties": {
    "schema": {
      "const": "artifact-delivery-extend-result.v1"
    },
    "outcome": {
      "const": "completed"
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "parameters-digest",
        "claims",
        "execution-receipt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000]+$"
        },
        "parameters-digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "retained-at",
              "effective-until",
              "policy-ref"
            ],
            "properties": {
              "claim": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "generation",
                  "body-digest"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[^\\s\\u0000]+$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "body-digest": {
                    "type": "string",
                    "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
                  }
                }
              },
              "retained-at": {
                "type": "integer",
                "minimum": 0
              },
              "effective-until": {
                "type": "integer",
                "minimum": 0
              },
              "policy-ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\s\\u0000]+$"
              }
            }
          }
        },
        "execution-receipt": {
          "$ref": "execution-receipt.v1.schema.json"
        }
      }
    }
  }
}
