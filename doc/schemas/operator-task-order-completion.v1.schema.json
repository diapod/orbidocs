{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbiplex:schema:operator-task-order-completion:v1",
  "title": "Operator Task Order Completion v1",
  "x-dia-workflow": "project",
  "x-dia-status": "draft",
  "x-dia-basis": ["doc/project/40-proposals/094-operator-task-packs-for-bounded-problem-solving.md"],
  "description": "Immutable host-retained result of an explicitly approved recipe publication. This is not a delivery receipt. The completion ref hashes the JCS document without completion/ref; replay delivers the retained dispatch result without a new executor or publication.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema/v", "completion/ref", "source", "recipe/digest", "dispatch/id", "answer", "dispatch/result"],
  "properties": {
    "schema": {"const": "operator-task-order-completion.v1"},
    "schema/v": {"const": 1},
    "completion/ref": {"type": "string", "pattern": "^operator-task-order-completion:sha256:[A-Za-z0-9_-]{43}$"},
    "source": {"$ref": "operator-task-verified-recipe.v1.schema.json#/$defs/source"},
    "recipe/digest": {"$ref": "operator-task-common.v1.schema.json#/$defs/digest"},
    "dispatch/id": {"$ref": "operator-task-common.v1.schema.json#/$defs/ref"},
    "answer": {"$ref": "corpus-reasoning-answer.v2.schema.json"},
    "dispatch/result": {"$ref": "service-dispatch-result.v2.schema.json"}
  }
}
